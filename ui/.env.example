# Required when building the UI. NEXT_PUBLIC_* values are embedded in the build output.
NEXT_PUBLIC_SITE_URL=https://www.example.invalid
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/api

# Server-only. Required where Next.js runs server requests: build time for prerendered pages and runtime for dynamic requests.
API_BASE_URL=https://api.example.invalid/api

# Umami is disabled when both values are empty. Set both to enable it.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
