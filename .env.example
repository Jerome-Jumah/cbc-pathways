DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cbc?schema=public&connection_limit=20"
PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
ENABLE_DEBUG_ROUTES=false
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=100000
RATE_LIMIT_MAX=150
LOG_FILE=app.log
SESSION_SECRET=change-me-to-a-random-32-character-minimum-secret
# Cloudflare Turnstile secret key for the backend. In local dev, make sure
# the matching Turnstile widget allows localhost in Cloudflare.
TURNSTILE_SECRET_KEY=
