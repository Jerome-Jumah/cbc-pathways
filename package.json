{
  "name": "cbc-intelligence",
  "version": "1.0.0",
  "description": "CBC Pathways Intelligence System",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.mts",
    "dist": "node dist/index.mjs",
    "lcl": "tsx watch src/index.mts",
    "bld-api": "rimraf dist build && npx tsdown src/index.mts && cp ./package.json ./dist",
    "build": "npm run bld-api",
    "postinstall": "prisma generate --schema ./prisma/schema.prisma",
    "ingest": "tsx src/run-ingestion.mts",
    "integrity": "tsx src/check-integrity.mts",
    "seed:tracks": "tsx src/jobs/seed-track-profiles.mts",
    "test": "node --test --test-timeout=30000 --import tsx \"tests/**/*.test.mts\"",
    "test:watch": "node --test --watch --test-timeout=30000 --import tsx \"tests/**/*.test.mts\"",
    "test:api": "node --test --test-timeout=30000 --import tsx \"tests/api/**/*.test.mts\"",
    "test:e2e": "npm --prefix ui run test:e2e"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.15.2",
    "axios-retry": "^4.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "p-limit": "^7.3.0",
    "pdf2json": "^4.0.3",
    "pg": "^8.20.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "prettier": {
    "printWidth": 140,
    "arrowParens": "avoid",
    "singleQuote": false
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
