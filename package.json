{
  "name": "cbc-intelligence",
  "version": "1.0.0",
  "description": "CBC Pathways Intelligence System",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.mts",
    "dist": "yarn node dist/index.mjs",
    "lcl": "yarn tsx watch src/index.mts",
    "bld-api": "rimraf dist build && npx tsdown && cp ./package.json ./dist",
    "bld-ui": "rimraf dist/public && cd ui && yarn install --network-timeout 100000 && yarn build && mv ./dist ../dist/public",
    "build": " yarn bld-api && yarn bld-ui",
    "postinstall": "prisma generate --schema ./prisma/schema.prisma",
    "ingest": "tsx src/run-ingestion.mts",
    "integrity": "tsx src/check-integrity.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.15.2",
    "axios-retry": "^4.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "p-limit": "^7.3.0",
    "pdf2json": "^4.0.3",
    "pg": "^8.20.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "prettier": {
    "printWidth": 140,
    "arrowParens": "avoid",
    "singleQuote": false
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
